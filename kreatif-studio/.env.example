# Bu dosyayı ".env" adıyla kopyala ve anahtarlarını buraya yaz.
# .env dosyası asla paylaşılmamalı ve git'e eklenmemeli.

# --- OpenAI (zorunlu: strateji, görev kartları, kalite kontrol ve görsel) ---
OPENAI_API_KEY=
# Metin modeli (strateji uyarlama, görev kartları). Ayarlar sayfasından da değiştirilebilir.
OPENAI_TEXT_MODEL=gpt-5.1
# Görseli inceleyip puanlayan model (görüntü okuyabilen bir model olmalı)
OPENAI_VISION_MODEL=gpt-5.1
# Görsel modeli
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high  (boş bırakılırsa gönderilmez; reasoning desteklemeyen modellerde boş bırak)
OPENAI_REASONING_EFFORT=medium
# gpt-image-1 için referans görsele (ürün/logo) sadakat. Desteklemeyen modelde boş bırak.
OPENAI_INPUT_FIDELITY=high

# --- Ideogram (opsiyonel: tipografi ağırlıklı kreatifler için) ---
IDEOGRAM_API_KEY=

# --- Sunucu ---
PORT=4747
# Aynı anda kaç görsel üretilsin
IMAGE_CONCURRENCY=2
# Kalite puanı bunun altındaysa görsel otomatik yeniden üretilir (0 = kapalı)
QA_MIN_SCORE=9
QA_AUTO_RETRY=2

# --- Kredi sistemi (ileride üyelik modeli için) ---
# Lokal kullanımda sınırsız; false yapılırsa bakiye kontrolü devreye girer.
CREDITS_UNLIMITED=true
STARTING_CREDITS=500
